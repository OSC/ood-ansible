# {{ ansible_managed }}

[ondemand-web]
name=Open OnDemand Web Repo
baseurl={{ ood_repo_base_url }}
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-ondemand
{% if ood_web_repo_user is defined and ood_web_repo_password is defined %}
username={{ ood_web_repo_user }}
password={{ ood_web_repo_password }}
{% endif %}

[ondemand-web-source]
name=Open OnDemand Web Repo
baseurl={{ ood_repo_src_base_url }}
enabled=0
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-ondemand
{% if ood_web_src_repo_user is defined and ood_web_src_repo_password is defined %}
username={{ ood_web_src_repo_user }}
password={{ ood_web_src_repo_password }}
{% endif %}
